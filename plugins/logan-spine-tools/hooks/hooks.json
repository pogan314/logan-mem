{
  "description": "logan-spine: nudge for missing docstrings after Edit/Write",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/docstring-check.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
